@startuml clases_rf10
title RF-10 Monitoreo de sensores - Diagrama de clases
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FDFEFE
  BorderColor #34495E
  ArrowColor #34495E
}
hide empty members

class Sucursal {
  - id: int
  - nombre: String
}

class Sensor {
  - id: String
  - tipo: TipoSensor
  - ubicacion: String
  - ultimaLectura: DateTime
  + estaActivo(timeoutSeg: int): boolean
}

class Lectura {
  - valor: double
  - fechaHora: DateTime
}

class Umbral {
  - tipo: TipoSensor
  - minimo: double
  - maximo: double
  + estaFueraDeRango(valor: double): boolean
}

class Alerta {
  - tipo: TipoAlerta
  - mensaje: String
  - fechaHora: DateTime
}

class ServicioMonitoreo {
  + recibirLectura(sensorId: String, valor: double): void
  + revisarSensoresSinDatos(): void
}

interface RepositorioLecturas {
  + guardar(lectura: Lectura): void
}

class PanelMonitoreo {
  + mostrarValores(lecturas: List<Lectura>): void
  + mostrarAdvertencia(mensaje: String): void
}

enum TipoSensor {
  TEMPERATURA
  HUMEDAD
  CONTEO_PERSONAS
}

enum TipoAlerta {
  FUERA_DE_RANGO
  SENSOR_SIN_DATOS
}

Sucursal "1" *-- "1..*" Sensor : tiene
Sucursal "1" *-- "0..*" Umbral : define
Sensor "1" -- "0..*" Lectura : registra
Alerta "0..*" --> "1" Sensor : sobre

ServicioMonitoreo ..> Umbral : evalúa
ServicioMonitoreo ..> Alerta : crea
ServicioMonitoreo --> RepositorioLecturas : guarda
PanelMonitoreo --> ServicioMonitoreo : consulta

@enduml
