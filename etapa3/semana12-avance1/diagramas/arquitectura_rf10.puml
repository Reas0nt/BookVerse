@startuml arquitectura_rf10
title RF-10 Monitoreo de sensores - Arquitectura de alto nivel
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #34495E
skinparam rectangle {
  BackgroundColor #FDFEFE
  BorderColor #34495E
}

actor "Técnico de\nmantenimiento" as Tecnico

rectangle "Sensores en sucursal\n(ESP32 + DHT22 + contador)" as Sensores
rectangle "Broker MQTT\n(Mosquitto)" as Broker
rectangle "Backend Flask\n(recibe, evalúa, alerta)" as Backend
database "MySQL" as DB
rectangle "Panel web\n(navegador)" as Panel

Sensores --> Broker : MQTT
Broker --> Backend : MQTT
Backend --> DB : SQL
Backend --> Panel : SSE / HTTP
Tecnico --> Panel

@enduml
