@startuml arquitectura_rf10
title RF-10 Monitoreo de sensores ambientales - Arquitectura de alto nivel
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #34495E
skinparam node {
  BackgroundColor #ECF0F1
  BorderColor #34495E
}
skinparam component {
  BackgroundColor #FDFEFE
  BorderColor #34495E
}

actor "Técnico de\nmantenimiento" as Tecnico

node "Capa Sucursal" as Sucursal {
  node "Nodo ESP32 (Wi-Fi)" as ESP {
    component "Sensor DHT22\n(temperatura y humedad)" as DHT
    component "Sensor IR/ToF\n(conteo de personas)" as IR
    component "Firmware\n(publica lecturas y heartbeat)" as FW
  }
}

node "Servidor BookVerse" as Server {
  component "Broker MQTT\n(Mosquitto)" as Broker
  node "Backend Flask" as Backend {
    component "Ingesta\n(suscriptor MQTT)" as Ingesta
    component "Servicio de monitoreo y alertas\n(umbrales, timeout, conexión)" as Monitor
    component "Vigilante de heartbeat\n(timeout de sensores y conexión)" as Watch
    component "API REST" as API
    component "Stream SSE\n(tiempo real)" as SSE
  }
  database "MySQL\n(lecturas, sensores,\numbrales, alertas)" as DB
}

node "Navegador del técnico" as Browser {
  component "Panel web de monitoreo\n(valores y advertencias)" as Panel
}

DHT --> FW : lectura I2C/GPIO
IR --> FW : lectura GPIO
FW --> Broker : MQTT\nlecturas + heartbeat\n(Wi-Fi)
Broker --> Ingesta : MQTT (suscripción)
Ingesta --> Monitor : lectura validada
Monitor --> DB : SQL\nINSERT lecturas / alertas
Ingesta --> Watch : marca de último dato
Watch ..> Monitor : sin datos tras timeout:\nalerta SENSOR_SIN_DATOS
Watch ..> Monitor : conexión caída:\nalerta SIN_CONEXION
API --> DB : SQL SELECT
Monitor --> SSE : valores y alertas nuevos
SSE --> Panel : SSE (HTTP)\nactualización en vivo
Panel --> API : HTTP/REST\nhistorial y estado
Tecnico --> Panel : consulta y\nreconoce alertas

note bottom of Monitor
  Ruta alterna: el heartbeat vencido marca el sensor como SIN_DATOS.
  Excepcion: si falla la conexión, se genera la advertencia
  SIN_CONEXION y se muestra en el panel.
end note
@enduml
